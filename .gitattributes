* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
# ComfyUI 启动器备份：还原后必须能直接当 .bat 用，行尾不能变。
docs/environment/launchers/*.original text eol=crlf
docs/environment/launchers/*.current text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.woff2 binary
# Vendored skill manifests contain byte-level SHA-256 checksums.
# Preserve upstream bytes/formatting and generated shader strings.
infinite-canvas/web/public/creation-skills/** -text -whitespace
infinite-canvas/web/dist/creation-skills/** -text -whitespace
infinite-canvas/web/dist/assets/** -whitespace
