{
  "1": {
    "class_type": "llama_cpp_model_loader",
    "inputs": {
      "model": "Qwen3.5-9B-Q4_K_M.gguf",
      "mmproj": "None",
      "chat_handler": "None",
      "n_ctx": 8192,
      "vram_limit": -1,
      "image_min_tokens": 0,
      "image_max_tokens": 0,
      "load_mtp": false
    },
    "_meta": { "title": "Qwen3.5-9B (H3 prompt)" }
  },
  "2": {
    "class_type": "TE_H3_Prompt_Enhancer",
    "inputs": {
      "输入提示词": "",
      "任务类型": "文生视频(T2VA)",
      "视频时长": 5,
      "参考素材说明": "",
      "增强方式": "本地模板",
      "api_key": "",
      "api_base_url": "https://teynex.com",
      "model": "gpt-5.6-sol",
      "max_output_tokens": 4096,
      "temperature": 0.6,
      "timeout_s": 300,
      "绕过代理": false
    },
    "_meta": { "title": "H3 Prompt Enhancer (local template only)" }
  },
  "3": {
    "class_type": "llama_cpp_instruct_adv",
    "inputs": {
      "llama_model": ["1", 0],
      "parameters": ["5", 0],
      "preset_prompt": "Empty - Nothing",
      "custom_prompt": ["2", 1],
      "system_prompt": "你是 MiniMax H3 视频提示词专家。严格按用户提供的提示词模板输出，不要解释。\n本地兼容规则（VDN / cfg=1）：\n1. 描述性文本全部用正向事实表述；no/not/without/avoid 等否定词在 cfg=1 下会作为普通 token 参与正向条件，可能反向生效，改写为正向事实（如 no blood → clean, intact, unretouched skin）。不要改台词、旁白、歌词和画面文字，不做全局替换。\n2. 有图片输入时用 <Picture 1>、<Picture 2> 标注身份/服装/场景来源，标签必须和实际输入一致；只有完全没有图片输入的纯文本 T2VA 不得伪造 Picture 标签，I2VA/FL2VA/L2VA/Ref2VA 的关键帧或参考图必须按实际输入使用对应标签。\n3. 用户要求单段/不切镜时写明 one continuous locked-off shot from a tripod（或等价正向表述）；用户要求切镜时按用户意图，不强制锁机位。\n4. 少堆 cinematic/photorealistic/8k/masterpiece 等泛化质量词，优先具体的光位、色温、镜头、材质、运动；不要一刀切禁用 cinematic。",
      "inference_mode": "images",
      "max_frames": 24,
      "max_size": 768,
      "seed": 0,
      "force_offload": true,
      "save_states": false
    },
    "_meta": { "title": "Qwen3.5 H3 local expansion" }
  },
  "4": {
    "class_type": "TE_text_display",
    "inputs": {
      "text": "",
      "input_text": ["3", 0],
      "use_edited_text": false,
      "edited_from_text": ""
    },
    "_meta": { "title": "H3 prompt output" }
  },
  "5": {
    "class_type": "llama_cpp_parameters",
    "inputs": {
      "max_tokens": 4096,
      "top_k": 20,
      "top_p": 0.9,
      "min_p": 0.05,
      "typical_p": 1,
      "temperature": 0.6,
      "repeat_penalty": 1,
      "frequency_penalty": 0,
      "present_penalty": 0,
      "mirostat_mode": 0,
      "mirostat_eta": 0.1,
      "mirostat_tau": 5,
      "state_uid": -1
    },
    "_meta": { "title": "Bounded H3 text generation" }
  }
}
