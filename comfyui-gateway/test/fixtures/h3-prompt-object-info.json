  "TE_H3_Prompt_Enhancer": {
    "input": {
      "required": {
        "输入提示词": [
          "STRING",
          {
            "default": "",
            "multiline": true,
            "tooltip": "输入剧情、动作、运镜、对白和引用标签，例如 <Picture 1>。"
          }
        ],
        "任务类型": [
          [
            "全参考模式(Reference to Video)",
            "文生视频(T2VA)",
            "首帧图生视频(I2VA)",
            "首尾帧视频(FL2VA)",
            "尾帧图生视频(L2VA)"
          ],
          {
            "default": "全参考模式(Reference to Video)",
            "tooltip": "按实际使用的 MiniMax H3 节点和首尾帧连接状态选择。"
          }
        ],
        "视频时长": [
          "FLOAT",
          {
            "default": 5,
            "min": 1,
            "max": 150,
            "step": 0.5,
            "tooltip": "用于规划镜头时间戳；H3 推荐生成时长约 5-15 秒。"
          }
        ],
        "参考素材说明": [
          "STRING",
          {
            "default": "",
            "multiline": true,
            "tooltip": "可选。按标签说明素材内容和用途；未说明时 AI 不会臆造素材细节。"
          }
        ],
        "增强方式": [
          [
            "本地模板",
            "API增强"
          ],
          {
            "default": "本地模板",
            "tooltip": "本地模板不调用接口；API增强直接输出可用于 H3 的中文提示词。"
          }
        ],
        "api_key": [
          "STRING",
          {
            "default": "",
            "multiline": false,
            "tooltip": "API Key；留空则读取 config.ini。"
          }
        ],
        "api_base_url": [
          "STRING",
          {
            "default": "https://teynex.com",
            "multiline": false,
            "tooltip": "Responses API 服务地址，可填写到域名、/v1 或 /v1/responses。"
          }
        ],
        "model": [
          "STRING",
          {
            "default": "gpt-5.6-sol",
            "multiline": false,
            "tooltip": "服务端支持的 Responses API 模型名称。"
          }
        ],
        "max_output_tokens": [
          "INT",
          {
            "default": 4096,
            "min": 512,
            "max": 32768,
            "step": 256
          }
        ],
        "temperature": [
          "FLOAT",
          {
            "default": 0.6,
            "min": 0,
            "max": 2,
            "step": 0.05
          }
        ]
      },
      "optional": {
        "H3参考素材": [
          "TE_H3_REFERENCES",
          {
            "tooltip": "连接 TE MAN MiniMaxH3增强提示词Prompt TEXT 的 H3参考素材输出。"
          }
        ],
        "timeout_s": [
          "INT",
          {
            "default": 300,
            "min": 30,
            "max": 1800,
            "tooltip": "API 请求超时时间（秒）。"
          }
        ],
        "绕过代理": [
          "BOOLEAN",
          {
            "default": false,
            "tooltip": "需要忽略系统代理时开启。"
          }
        ]
      }
    },
    "output": [
      "STRING",
      "STRING"
    ],
    "output_is_list": [
      false,
      false
    ]
  },
